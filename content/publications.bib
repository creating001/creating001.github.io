@inproceedings{wu2026mac,
  title = {MAC: A Conversion Rate Prediction Benchmark Featuring Labels Under Multiple Attribution Mechanisms},
  author = {Jinqi Wu# and Sishuo Chen# and Zhangming Chan and Yong Bai and Lei Zhang and Sheng Chen and Chenghuan Hou and Xiang-Rong Sheng and Han Zhu and Jian Xu and Bo Zheng and Chaoyou Fu*},
  booktitle = {Proceedings of the 32nd ACM SIGKDD Conference on Knowledge Discovery and Data Mining V.2 (KDD 2026)},
  year = {2026},
  month = aug,
  doi = {10.1145/3770855.3817488},
  url = {https://doi.org/10.1145/3770855.3817488},
  pdf = {/papers/MAC.pdf},
  code = {https://github.com/alimama-tech/PyMAL},
  selected = {true},
  preview = {mac-preview.png},
  description = {A public multi-attribution CVR benchmark, the PyMAL toolkit, and Mixture of Asymmetric Experts (MoAE) for learning from multiple attribution mechanisms.},
  abstract = {Multi-attribution learning enhances conversion rate prediction by learning from labels generated under multiple attribution mechanisms. We introduce MAC, a public benchmark with first-click, last-click, linear, and data-driven attribution labels, together with the PyMAL algorithm library. Systematic experiments reveal when auxiliary attribution objectives help and identify architectural principles for effective knowledge transfer. Motivated by these findings, we propose Mixture of Asymmetric Experts (MoAE), which combines comprehensive multi-attribution knowledge learning with main-task-oriented knowledge utilization.},
  keywords = {Conversion Rate Prediction, Multi-Attribution Learning, Dataset and Benchmark, Computational Advertising}
}

@inproceedings{wu2026touchpoints,
  title = {Can Large Language Models Identify Meaningful Touchpoints in Conversion Attribution?},
  author = {Jinqi Wu# and Sishuo Chen# and Zhangming Chan and Yong Bai and Chao Yi and Han Zhu and Shuodian Yu and Lei Zhang and Sheng Chen and Chenghuan Hou and Jian Xu* and Chaoyou Fu},
  booktitle = {Proceedings of the 35th ACM International Conference on Information and Knowledge Management (CIKM 2026)},
  year = {2026},
  month = nov,
  doi = {10.1145/3799682.3839867},
  url = {https://doi.org/10.1145/3799682.3839867},
  pdf = {/papers/LLM_Attribution.pdf},
  selected = {true},
  preview = {lotus-preview.png},
  description = {The SILVA benchmark evaluates semantic touchpoint selection; LOTUS uses LLM-attributed signals to improve industrial CVR prediction.},
  abstract = {Existing conversion attribution methods often overlook implicitly related touchpoints that lack explicit taxonomy or collaborative-filtering associations. We introduce SILVA, a benchmark for full-path touchpoint selection, and systematically evaluate large language models across prompting strategies and model families. LLMs recover meaningful implicit associations, while substantial room for improvement remains. We further introduce LLM-Oriented Touchpoint Understanding and Selection (LOTUS), using LLM-attributed labels as auxiliary training signals to improve industrial CVR prediction.},
  keywords = {Large Language Models, Conversion Attribution, Touchpoint Selection, Recommendation}
}
